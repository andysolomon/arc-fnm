# Friday Night Manager — local environment
#
# Copy to `.env.local` (git-ignored) and edit. Every value here is optional: a
# clean checkout runs fully on the deterministic in-memory adapter.

# Convex deployment URL. Leave unset to use the local demo adapter, where the
# week is playable but decisions reset on reload.
#
# Must be a bare https origin on a Convex deployment host, exactly as printed by
# `npx convex dev`:
#
#   VITE_CONVEX_URL=https://your-project-123.convex.cloud
#
# Rejected on purpose, with the reason shown in the app footer:
#   http://your-project-123.convex.cloud       — must be https
#   https://localhost:3210                     — local backends are not supported
#   https://example.com                        — not a *.convex.cloud host
#   https://your-project-123.convex.cloud/api  — no path, query, or fragment
#
# A rejected value never breaks the app; it falls back to the local adapter.
# VITE_CONVEX_URL=https://your-project-123.convex.cloud
